# Telegram Focus — muhit o'zgaruvchilari namunasi.
# Bu faylni backend/.env nomi bilan nusxalang va haqiqiy qiymatlarni kiriting.
# Hech qachon haqiqiy qiymatlar bilan to'ldirilgan .env faylni git'ga
# qo'shmang yoki chatga yubormang.

# --- Autentifikatsiya (majburiy) ---
APP_PASSWORD=
COOKIE_SECURE=false

# --- Telegram (Telethon) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# --- Telegram bot (imkoniyatlarni guruhga yuborish uchun) ---
BOT_TOKEN=
OWNER_ID=

# --- Gemini AI (triage, tahlil, chat) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Email (agar email integratsiyasi ishlatilsa) ---
EMAIL_SECRET_KEY=

# --- Server sozlamalari ---
ALLOWED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO
DATABASE_URL=
